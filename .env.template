# St. Xavier IT Helpdesk Kiosk Configuration
# -------------------------------------------
# Copy this file to .env and fill in your actual values.
# The .env file is git-ignored and will NOT be committed.

# SMTP Settings (for sending emails to Freshdesk)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=kiosk@your-school.org
SMTP_PASSWORD=your_smtp_password_here

# Freshdesk Email (where tickets are created)
FRESHDESK_EMAIL=helpdesk@stxavier.org

# Database Settings (PostgreSQL via ODBC)
DB_SERVER=your-db-host.your-school.org
DB_DATABASE=your_database
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER={PostgreSQL Unicode(x64)}

# Schedule Settings (when the helpdesk is open)
# Hours in 24-hour format
OPEN_HOUR=7
CLOSE_HOUR=16
# Days open: 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday, 5=Saturday, 6=Sunday
OPEN_DAYS=0,1,2,3,4
